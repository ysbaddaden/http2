module HTTP2
  module HPACK
    def self.encoded_bytesize(string : String) : Int64
      bit_size = 0_i64
      string.each_byte { |chr| bit_size += HUFFMAN_LENGTHS.unsafe_fetch(chr) }
      (bit_size + 7) // 8
    end

    def self.huffman_encode(string : String) : Bytes
      io = IO::Memory.new(encoded_bytesize(string))
      huffman_encode(io, string)
      io.to_slice
    end

    def self.huffman_encode(io : IO, string : String) : Nil
      buffer = 0_u64
      pending = 0

      string.each_byte do |chr|
        len = HUFFMAN_LENGTHS.unsafe_fetch(chr).to_i
        buffer = (buffer << len) | HUFFMAN_TABLE.unsafe_fetch(chr).to_u64
        pending += len

        while pending >= 8
          pending -= 8
          io.write_byte((buffer >> pending).to_u8!)
        end
      end

      if pending > 0
        io.write_byte(((buffer << (8 - pending)) | (0xff_u64 >> pending)).to_u8!)
      end
    end

    def self.huffman_decode(bytes : Bytes) : String
      # Every decoded byte consumes at least five encoded bits.
      String.build(bytes.size.to_i64 * 8 // 5) do |io|
        state = 0
        bit_size = 0

        bytes.each do |byte|
          {% for i in 0..7 %}
            bit_size += 1

            bit = byte.bit(7 - {{i}})

            # State offsets are even and at most table.size - 2; bit is 0 or 1.
            state = HUFFMAN_TRANSITIONS.unsafe_fetch(state + bit).to_i
            raise Error.new("unexpected huffman EOS symbol") if state == -257

            if state < 0
              io.write_byte((-state - 1).to_u8)
              state = 0

              bit_size = 0
            end
          {% end %}
        end

        # RFC 7541, section 5.2
        raise Error.new("huffman string padding is larger than 7-bits") if bit_size > 7
        # States 0, 2, ..., 14 are the root and the first seven EOS prefixes.
        raise Error.new("huffman string padding must use MSB of EOS symbol") unless state <= 14
      end
    end

